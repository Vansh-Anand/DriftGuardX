{
  "title": "DriftGuard-X Core Operations",
  "panels": [
    {
      "title": "Trace Ingestion Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(driftguard_trace_ingestion_total[1m])",
          "legendFormat": "TPS"
        }
      ]
    },
    {
      "title": "Certificate Verification Latency (p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(driftguard_certificate_verification_duration_seconds_bucket[5m]))",
          "legendFormat": "Latency (s)"
        }
      ]
    },
    {
      "title": "Generative Budget Consumed",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(driftguard_budget_usd_consumed_total)",
          "legendFormat": "Total USD"
        }
      ]
    }
  ],
  "schemaVersion": 36,
  "timezone": "browser"
}
