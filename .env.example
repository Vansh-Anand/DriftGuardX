# SECURITY NOTICE
# Copy this file to .env and fill in values for local development.
# NEVER commit .env with real secrets. Never commit API keys, passwords, or tokens.

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=driftguardx
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEBUG=false

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=driftguardx
POSTGRES_USER=driftguardx
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_USE
DATABASE_URL=postgresql+asyncpg://driftguardx:CHANGE_ME_BEFORE_USE@localhost:5432/driftguardx

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── OpenTelemetry Collector ──────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=driftguardx-api

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=CHANGE_ME_BEFORE_USE_MIN_32_CHARS

# ─── Web Console ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true

# ─── Provider Adapters (optional — NOT used in Prompt 01 deterministic mock) ──
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_REDACTION=true
ENABLE_POLICY_GATE=true
POLICY_DEFAULT_DENY=true
