# SECURITY NOTICE
# Copy this file to .env and fill in values for local development.
# NEVER commit .env with real secrets. Never commit API keys, passwords, or tokens.

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=driftguardx
APP_VERSION=2.0.0-rc.1
LOG_LEVEL=INFO
DEBUG=false

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=driftguardx
POSTGRES_USER=driftguardx
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_USE
DATABASE_URL=postgresql+asyncpg://driftguardx:CHANGE_ME_BEFORE_USE@localhost:5432/driftguardx

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── OpenTelemetry Collector ──────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=driftguardx-api

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=CHANGE_ME_BEFORE_USE_MIN_32_CHARS
AUTH_MODE=mock
# Production requires AUTH_MODE=oidc and all three HTTPS OIDC values.
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=driftguardx-api
# OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
ALLOW_JIT_USER_PROVISIONING=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_BODY_BYTES=2097152
DGX_CAPABILITY_SECRET=CHANGE_ME_CAPABILITY_SECRET_MIN_32_CHARS
DGX_TRANSPORT_KEY=CHANGE_ME_TRANSPORT_KEY_MIN_32_CHARS

# ─── Web Console ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true

# ─── Provider Adapters (optional — NOT used in Prompt 01 deterministic mock) ──
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_REDACTION=true
ENABLE_POLICY_GATE=true
POLICY_DEFAULT_DENY=true
